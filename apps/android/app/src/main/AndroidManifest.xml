<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dictation records with the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Alerts when a bot needs you or finishes, even with the app closed:
         a foreground service keeps a live connection to your own server. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Phone mode: finish a routine that fired while gbot was closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Phone mode: routines fire on time with the app closed. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".GbotApp"
        android:label="gbot"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Gbot"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!-- The GPU backend for the on-device model. CPU is used when absent. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a page, a note or a selection straight to a bot. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- gbot://chat/<id> opens that chat. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gbot" />
            </intent-filter>
        </activity>

        <service
            android:name=".live.LiveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <!-- Phone mode: holds the Slack connection open while the app is closed. -->
        <service
            android:name=".live.LocalService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|dataSync" />

        <receiver
            android:name=".live.RoutineAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".live.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".live.CardActionReceiver"
            android:exported="false" />
    </application>
</manifest>
