! Calm dark window chrome to match gbot: one neutral title bar, Inter,
! and round traffic-light buttons on the left.
*font: Inter-10:bold
*textColor: #F2F2F2
*justify: center
window.title.focus: flat solid
window.title.focus.color: #26262A
window.title.unfocus: flat solid
window.title.unfocus.color: #1E1E21
window.label.focus: parentrelative
window.label.focus.textColor: #F2F2F2
window.label.unfocus: parentrelative
window.label.unfocus.textColor: #8A8A92
window.button.focus: flat solid
window.button.focus.color: #26262A
window.button.unfocus: flat solid
window.button.unfocus.color: #1E1E21
window.button.pressed: flat solid
window.button.pressed.color: #26262A
window.close.pixmap: /home/gbot/.fluxbox/pixmaps/close.xpm
window.close.unfocus.pixmap: /home/gbot/.fluxbox/pixmaps/idle.xpm
window.close.pressed.pixmap: /home/gbot/.fluxbox/pixmaps/close.xpm
window.iconify.pixmap: /home/gbot/.fluxbox/pixmaps/min.xpm
window.iconify.unfocus.pixmap: /home/gbot/.fluxbox/pixmaps/idle.xpm
window.iconify.pressed.pixmap: /home/gbot/.fluxbox/pixmaps/min.xpm
window.maximize.pixmap: /home/gbot/.fluxbox/pixmaps/max.xpm
window.maximize.unfocus.pixmap: /home/gbot/.fluxbox/pixmaps/idle.xpm
window.maximize.pressed.pixmap: /home/gbot/.fluxbox/pixmaps/max.xpm
window.handle.focus: flat solid
window.handle.focus.color: #26262A
window.handle.unfocus: flat solid
window.handle.unfocus.color: #1E1E21
window.grip.focus: flat solid
window.grip.focus.color: #26262A
window.grip.unfocus: flat solid
window.grip.unfocus.color: #1E1E21
window.frame.focusColor: #26262A
window.frame.unfocusColor: #1E1E21
window.borderWidth: 1
window.borderColor: #34343A
window.title.height: 30
window.bevelWidth: 8
window.handleWidth: 0
menu.frame: flat solid
menu.frame.color: #1E1E21
menu.frame.textColor: #F2F2F2
menu.frame.font: Inter-10
menu.title: flat solid
menu.title.color: #26262A
menu.title.textColor: #F2F2F2
menu.hilite: flat solid
menu.hilite.color: #8B5CF6
menu.hilite.textColor: #FFFFFF
menu.borderWidth: 0
menu.itemHeight: 26
background: none
