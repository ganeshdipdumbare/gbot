# The dock: a floating pill at the bottom with the computer's two apps.
# Pseudo-transparent over the wallpaper (no compositor needed).

# Backgrounds: 1 the pill, 2 an icon under the pointer.
rounded = 16
border_width = 1
border_sides = TBLR
background_color = #1c1c1f 62
border_color = #ffffff 16
background_color_hover = #1c1c1f 62
border_color_hover = #ffffff 16

rounded = 11
border_width = 0
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 14
border_color_hover = #ffffff 0
background_color_pressed = #ffffff 22
border_color_pressed = #ffffff 0

panel_items = L
panel_size = 100% 64
panel_margin = 0 12
panel_padding = 8 6 6
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_shrink = 1
panel_dock = 0
panel_window_name = gbot-dock
wm_menu = 0
strut_policy = follow_size
autohide = 0
disable_transparency = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 6
mouse_pressed_icon_asb = 100 0 -8

launcher_padding = 2 2 6
launcher_background_id = 0
launcher_icon_background_id = 2
launcher_icon_size = 44
launcher_icon_asb = 100 0 0
launcher_tooltip = 1
launcher_item_app = /usr/local/share/gbot/dock/browser.desktop
launcher_item_app = /usr/local/share/gbot/dock/terminal.desktop

tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 1
tooltip_font_color = #f2f2f2 100
tooltip_font = Inter 10
